diff --git a/cmd/listen_unix.go b/cmd/listen_unix.go
new file mode 100644
index 0000000..1fc36be
--- /dev/null
+++ b/cmd/listen_unix.go
@@ -0,0 +1,25 @@
+//go:build !windows
+
+package cmd
+
+import (
+	"net"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+// listenConfig sets SO_REUSEPORT so a new process can take over the port during a restart.
+func listenConfig() net.ListenConfig {
+	return net.ListenConfig{
+		Control: func(network, address string, c syscall.RawConn) error {
+			var serr error
+			if err := c.Control(func(fd uintptr) {
+				serr = unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_REUSEPORT, 1) // #nosec G115
+			}); err != nil {
+				return err
+			}
+			return serr
+		},
+	}
+}
