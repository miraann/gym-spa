{
  "name": "gym-spa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @gym/app dev",
    "build": "pnpm --filter @gym/app build",
    "preview": "pnpm --filter @gym/app preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "pnpm --filter @gym/staff-admin test:int && pnpm --filter @gym/seller-admin test:int",
    "test:deno": "pnpm --filter @gym/supabase test:deno",
    "test:e2e": "pnpm --filter @gym/app test:e2e && pnpm --filter @gym/desktop test:e2e && pnpm --filter @gym/seller test:e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "android:apk": "pnpm --filter @gym/app android:apk",
    "android:open": "pnpm --filter @gym/app android:open",
    "android:release": "pnpm --filter @gym/app android:release",
    "android:new-key": "pnpm --filter @gym/app android:new-key",
    "android:restore-key": "pnpm --filter @gym/app android:restore-key",
    "desktop:dev": "pnpm --filter @gym/desktop dev",
    "desktop:start": "pnpm build && pnpm --filter @gym/desktop start",
    "desktop:exe": "pnpm build && pnpm --filter @gym/desktop exe",
    "desktop:exe:offline": "pnpm server:bundle && pnpm --filter @gym/app build:offline && pnpm --filter @gym/desktop exe:offline",
    "db:start": "pnpm --filter @gym/supabase start",
    "db:stop": "pnpm --filter @gym/supabase stop",
    "db:status": "pnpm --filter @gym/supabase status",
    "db:reset": "pnpm --filter @gym/supabase reset",
    "db:test": "pnpm --filter @gym/supabase test",
    "db:lint": "pnpm --filter @gym/supabase lint",
    "db:functions": "pnpm --filter @gym/supabase functions",
    "db:types": "pnpm --filter @gym/supabase types && prettier --write --log-level warn packages/db/src/database.types.ts",
    "bootstrap:admin": "pnpm --filter @gym/supabase bootstrap:admin",
    "license:new-key": "pnpm --filter @gym/supabase license:new-key",
    "license:restore-key": "pnpm --filter @gym/supabase license:restore-key",
    "bootstrap:platform-admin": "pnpm --filter @gym/supabase bootstrap:platform-admin",
    "platform-admin:reset-2fa": "pnpm --filter @gym/supabase platform-admin:reset-2fa",
    "staff-logins:move": "pnpm --filter @gym/supabase staff-logins:move",
    "smoke:staff-admin": "pnpm --filter @gym/supabase smoke:staff-admin",
    "smoke:license": "pnpm --filter @gym/supabase smoke:license",
    "release:migrations": "pnpm --filter @gym/supabase release:migrations",
    "release:check-live": "pnpm --filter @gym/app check-live",
    "server:tools": "pnpm --filter @gym/server tools",
    "server:bundle": "pnpm --filter @gym/server bundle",
    "server:dev": "pnpm --filter @gym/server dev",
    "server:pgtap": "pnpm --filter @gym/server pgtap",
    "test:offline": "pnpm --filter @gym/server test:offline"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
