{
  "name": "@gym/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Windows desktop shell (Electron) for the Gym & Spa app",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "pnpm build && node scripts/start.mjs",
    "dev": "pnpm build && node scripts/start.mjs --dev",
    "exe": "pnpm build && electron-builder --win --config electron-builder.config.mjs",
    "exe:offline": "pnpm build && electron-builder --win --config electron-builder.offline.config.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@gym/core": "workspace:*",
    "@gym/platform": "workspace:*",
    "@playwright/test": "^1.63.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-updater": "6.8.10",
    "esbuild": "^0.28.2"
  },
  "optionalDependencies": {
    "smartcard": "3.7.2"
  }
}
