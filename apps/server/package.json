{
  "name": "@gym/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The offline edition's server PC: Postgres, Supabase Auth and PostgREST behind gym-server",
  "scripts": {
    "tools": "tsx src/cli/tools.ts",
    "bundle": "node scripts/bundle.mjs",
    "dev": "tsx src/cli/dev.ts",
    "serve": "tsx src/cli/serve.ts",
    "admin": "tsx src/cli/admin.ts",
    "pgtap": "tsx src/cli/pgtap.ts",
    "test:offline": "node ../../packages/local-lock/src/cli.ts test:offline \"tsx src/cli/test-offline.ts\"",
    "test:int": "vitest run --config vitest.int.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@gym/core": "workspace:*",
    "@gym/db": "workspace:*",
    "@gym/staff-admin": "workspace:*",
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
