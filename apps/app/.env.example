# Copy to .env.local and fill in. Only VITE_* values reach the browser — never put the
# Supabase secret (service role) key in this app.

# Supabase project (Dashboard → Project Settings → API). For the local backend, copy .env.e2e to
# .env.development.local instead (used by `pnpm dev`). A build without these values can't log in.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# PowerSync instance URL. Local: http://127.0.0.1:54380 (`pnpm sync:start`). These addresses also
# go into the Content-Security-Policy, so changing them needs a new build.
VITE_POWERSYNC_URL=
