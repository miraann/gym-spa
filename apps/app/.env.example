# Copy to .env.local and fill in. Only VITE_* values reach the browser — never put the
# Supabase secret (service role) key in this app.

# Supabase project (Dashboard → Project Settings → API). Local: `pnpm db:status` (API_URL,
# PUBLISHABLE_KEY). Used from step 1d.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# PowerSync instance URL. Local: http://localhost:54380 (`pnpm sync:start`). Used from step 1d.
VITE_POWERSYNC_URL=
