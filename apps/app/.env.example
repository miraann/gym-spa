# Copy to .env.local and fill in. Only VITE_* values reach the browser — never put the
# Supabase secret (service role) key in this app.

# Supabase project (Dashboard → Project Settings → API). Used from step 1c/1d.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# PowerSync instance URL. Used from step 1d.
VITE_POWERSYNC_URL=
