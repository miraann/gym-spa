# Local Supabase (`pnpm db:start`) for `pnpm test:e2e`, which
# builds with `--mode e2e`. The key is the fixed publishable key every local Supabase uses; it is
# not a secret. Cloud values belong in .env.local (not committed).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Never read by the app. e2e/bundle.spec.ts checks that it is not in the build: only variables the
# code reads one by one (import.meta.env.VITE_NAME) may reach the browser.
VITE_E2E_UNUSED=unused-variable-must-not-reach-the-bundle
