{
  "name": "@gym/supabase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Database migrations, RLS tests, seed data and admin scripts (Supabase)",
  "scripts": {
    "start": "supabase start --workdir ..",
    "stop": "supabase stop --workdir ..",
    "status": "supabase status --workdir ..",
    "reset": "supabase db reset --workdir ..",
    "test": "supabase test db --workdir ..",
    "lint": "supabase db lint --workdir .. --local --schema public,app --level warning --fail-on warning",
    "types": "supabase gen types typescript --local --workdir .. --schema public > ../packages/db/src/database.types.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@gym/core": "workspace:*",
    "@gym/db": "workspace:*",
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "supabase": "^2.119.0",
    "tsx": "^4.23.15"
  }
}
