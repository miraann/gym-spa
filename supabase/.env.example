# Only for `pnpm bootstrap:admin --remote` (creating the first Super Admin of a cloud project).
# Copy to supabase/.env.local, which git ignores. Never put the secret key anywhere else, and
# never in the app: it bypasses every security rule.
# Values: Supabase Dashboard → Project Settings → API Keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
