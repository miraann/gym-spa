# Server-side values for scripts on your PC (README → A cloud project). Copy to
# supabase/.env.local, which git ignores. Never put these anywhere else: not in Vercel, not in the
# app. The secret key and the database password bypass every security rule.

# For `pnpm bootstrap:admin --remote`. Supabase Dashboard → Project Settings → API Keys.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# For `supabase db push --db-url`. Dashboard → Connect → Session pooler (port 5432, not 6543),
# with the database password filled in and its special characters URL-encoded (@ → %40).
SUPABASE_DB_URL=
