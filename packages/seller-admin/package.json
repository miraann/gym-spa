{
  "name": "@gym/seller-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The seller panel's server module: gyms with their first Owner, and platform admin logins, through the Supabase Auth admin API (Edge Function seller-admin)",
