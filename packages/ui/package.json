{
  "name": "@gym/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The shared UI of the gym app and the seller panel: the Calm Bento theme, fonts, shadcn/ui components and layout blocks",
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./blocks/*": "./src/blocks/*.tsx",
    "./hooks/*": "./src/hooks/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./fonts": "./src/fonts.ts",
    "./theme.css": "./src/styles/theme.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/vazirmatn": "^5.3.0",
    "@gym/i18n": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.51.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-i18next": "^17.0.15",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "fontkit": "^2.0.4"
  }
}
